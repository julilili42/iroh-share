{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iroh Share",
  "identifier": "computer.iroh.share",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Iroh Share",
        "width": 680,
        "height": 560,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
